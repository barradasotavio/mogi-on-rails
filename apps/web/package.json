{
  "name": "@mkw/web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "scripts": {
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node scripts/serve-static.mjs",
    "lint": "eslint . --max-warnings 0 && npm run check:design",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json",
    "test": "node ../../scripts/run-validation.mjs app-quick",
    "check": "node ../../scripts/run-validation.mjs all",
    "check:compiler": "node scripts/check-compiler.ts",
    "prepare:ocr": "node scripts/prepare-ocr.ts",
    "generate:startup": "node scripts/generate-startup-images.ts",
    "predev": "npm run prepare:ocr",
    "prebuild": "npm run prepare:ocr",
    "fixtures:ocr": "node scripts/prepare-ocr-fixture.ts",
    "postbuild": "npm run check:fonts && node scripts/prepare-offline.ts",
    "check:fonts": "node scripts/check-font-assets.ts",
    "check:design": "node scripts/check-design-system.ts",
    "test:design": "node --test scripts/check-design-system.test.ts",
    "test:quick": "node ../../scripts/run-validation.mjs app-quick",
    "test:focused": "node ../../scripts/run-validation.mjs focused"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@mkw/engine": "*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.5.0",
    "fflate": "0.8.3",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.6.0",
    "valibot": "1.5.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.56.1",
    "@shadcn/lint": "0.2.3",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "oxc-transform-react": "0.152.0",
    "postcss": "8.5.23",
    "react-server-dom-webpack": "19.3.1",
    "shadcn": "4.23.0",
    "sharp": "0.35.4",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vinext": "1.3.0",
    "vite": "8.0.13"
  },
  "type": "module"
}
